{
  "name": "phoenix-app",
  "version": "1.0.0",
  "private": true,
  "description": "A phone-first personal command center (PWA) with re-shapeable panels, fictional data and a setup agent.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && node scripts/sync-skills.mjs --check",
    "sync-skills": "node scripts/sync-skills.mjs"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
