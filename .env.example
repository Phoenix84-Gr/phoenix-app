# Copy this file to .env.local and fill it in yourself (never commit .env.local; it is git-ignored).
# These are SERVER variables: none has the NEXT_ PUBLIC prefix, so they never reach the browser.

# "mock" = offline demo assistant, no key (default). "openai_compatible" = your own model.
ASSISTANT_PROVIDER=mock

# Only for openai_compatible. Examples: https://api.openai.com/v1 · https://openrouter.ai/api/v1 ·
# http://localhost:11434/v1 (Ollama) · http://localhost:1234/v1 (LM Studio)
ASSISTANT_BASE_URL=https://api.example.com/v1
ASSISTANT_MODEL=your-model

# Your provider key (not needed for Ollama / LM Studio on this computer). Type it yourself.
ASSISTANT_API_KEY=

# Only behind a host or proxy that overwrites x-forwarded-for: then each visitor gets their own message limit.
# TRUST_PROXY_HEADER=true

# Required for any real provider: the app has no login, so the chat asks for this code (12+ characters).
ASSISTANT_ACCESS_CODE=
